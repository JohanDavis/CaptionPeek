{
    "manifest_version": 3,
    "name": "CaptionPeek",
    "version": "2.1",
    "description": "Temporarily enables YouTube captions whenever you rewind a video using the left arrow key.",
    "permissions": ["storage"],
    "icons": {
        "16": "icons/logo.png"
    },
    "host_permissions": ["*://*.youtube.com/*"],
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "CaptionPeek Settings"
    }
}
